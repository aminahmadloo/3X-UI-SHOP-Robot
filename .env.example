
# Referral reward settings
SHOP_REFERRER_REWARD_ENABLED=true
SHOP_REFERRER_REWARD_TYPE=money
SHOP_REFERRER_LEVEL_ONE_RATE=30
SHOP_REFERRER_LEVEL_TWO_RATE=0

# OpenAI AI content manager
# Keep the key only in the server .env; never commit a real secret.
OPENAI_API_KEY=

# Full Backup external storage: Backblaze B2 (S3-compatible)
# Keep the B2 bucket private. The bot generates a short-lived presigned GET URL.
# Set FULL_BACKUP_STORAGE_ENABLED=true only after creating the private B2 bucket
# and an application key restricted to that bucket.
FULL_BACKUP_STORAGE_ENABLED=false
FULL_BACKUP_STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
FULL_BACKUP_STORAGE_BUCKET=toonelvpn-backups
FULL_BACKUP_STORAGE_ACCESS_KEY_ID=
FULL_BACKUP_STORAGE_SECRET_ACCESS_KEY=
FULL_BACKUP_STORAGE_REGION=us-west-004
# 1 second to 7 days; 86400 = 24 hours.
FULL_BACKUP_STORAGE_URL_EXPIRES_SECONDS=86400
FULL_BACKUP_STORAGE_PREFIX=toonelvpn/full-backups
