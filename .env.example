BOT_TOKEN="1234567890:qwerty"
BOT_DEV_ID=123456789
BOT_SUPPORT_ID=123456789
BOT_DOMAIN=3xui-shop.com

XUI_USERNAME=admin
XUI_PASSWORD=admin

# ZarinPal payment gateway
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHOP_PAYMENT_ZARINPAL_ENABLED=true
SHOP_CURRENCY=IRT

# ZarinPal custom payment subdomain (must be connected to ZarinPal)
ZARINPAL_PAYMENT_BASE_URL=https://payment.yashginartgallery.com
# Optional: defaults below are ZarinPal production endpoints.
# ZARINPAL_API_BASE_URL=https://api.zarinpal.com
# ZARINPAL_REQUEST_PATH=/pg/v4/payment/request.json
# ZARINPAL_VERIFY_PATH=/pg/v4/payment/verify.json
# ZARINPAL_DIRECT_PAYMENT_BASE_URL=https://www.zarinpal.com
# ZARINPAL_HTTP_TIMEOUT=20

# AbanGateway smart card-to-card payment
# Set both values to enable the gateway. Use test_ token for sandbox testing.
ABAN_GATEWAY_TOKEN=
ABAN_GATEWAY_WEBHOOK_SECRET=
# Optional: defaults to https://abangateway.ir/api/v1
# ABAN_GATEWAY_API_BASE_URL=https://abangateway.ir/api/v1

# BluPal smart card-to-card payment
# Use blu_test_... for Sandbox and blu_live_... for production.
BLUPAL_API_KEY=
# Optional: defaults to https://blupal.net/api
BLUPAL_API_BASE_URL=https://blupal.net/api
# Webhook URL to register in BluPal: https://<BOT_DOMAIN>/webhooks/blupal

# Variza smart card-to-card secondary gateway (isolated from existing gateways)
# Disabled by default. Enable from the dedicated admin menu after configuring the credentials.
VARIZA_ENABLED=false
VARIZA_API_KEY=
VARIZA_WEBHOOK_SECRET=
# Optional: https://variza.ir/api/v1
VARIZA_API_BASE_URL=https://variza.ir/api/v1
# Optional fixed recipient card last 4 digits. Leave empty to use Variza account default.
VARIZA_CARD_LAST_4=
# Optional link lifetime: 30m, 1h, 2h, 6h, 1d, 1w, never
VARIZA_EXPIRES_IN=1h
# Optional HTTPS return URL. Defaults to BOT_DOMAIN/payments/variza/return.
VARIZA_RETURN_URL=

# Card-to-card wallet top-up
SHOP_CARD_NUMBER=6037991234567890

LETSENCRYPT_EMAIL=example@email.com

# Referral reward settings
SHOP_REFERRER_REWARD_ENABLED=true
SHOP_REFERRER_REWARD_TYPE=money
SHOP_REFERRER_LEVEL_ONE_RATE=30
SHOP_REFERRER_LEVEL_TWO_RATE=0

# OpenAI AI content manager
# Keep the key only in the server .env; never commit a real secret.
OPENAI_API_KEY=

# Full Backup external storage (S3-compatible; Cloudflare R2 recommended)
# When enabled, backups larger than 49MB are uploaded as one .tar.gz object and
# the developer receives a time-limited presigned download link instead of Telegram parts.
# The bucket should remain private; the presigned URL is the temporary access mechanism.
FULL_BACKUP_STORAGE_ENABLED=false
FULL_BACKUP_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
FULL_BACKUP_STORAGE_BUCKET=toonelvpn-backups
FULL_BACKUP_STORAGE_ACCESS_KEY_ID=
FULL_BACKUP_STORAGE_SECRET_ACCESS_KEY=
FULL_BACKUP_STORAGE_REGION=auto
# 1 second to 7 days; 86400 = 24 hours.
FULL_BACKUP_STORAGE_URL_EXPIRES_SECONDS=86400
FULL_BACKUP_STORAGE_PREFIX=toonelvpn/full-backups
