BOT_TOKEN="1234567890:qwerty"
BOT_DEV_ID=123456789
BOT_SUPPORT_ID=123456789
BOT_DOMAIN=3xui-shop.com

XUI_USERNAME=admin
XUI_PASSWORD=admin

# ZarinPal payment gateway
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHOP_PAYMENT_ZARINPAL_ENABLED=true
SHOP_CURRENCY=IRT

# Optional custom payment URL. If empty, customers go directly to ZarinPal.
# The configured host must point to the ToonelVPN bot HTTP service.
ZARINPAL_PAYMENT_BASE_URL=https://payment.yashginartgallery.com

# ZarinPal API / payment endpoints (normally keep the defaults)
ZARINPAL_API_BASE_URL=https://api.zarinpal.com
ZARINPAL_REQUEST_PATH=/pg/v4/payment/request.json
ZARINPAL_VERIFY_PATH=/pg/v4/payment/verify.json
ZARINPAL_DIRECT_PAYMENT_BASE_URL=https://www.zarinpal.com
ZARINPAL_HTTP_TIMEOUT=20

# Card-to-card wallet top-up
SHOP_CARD_NUMBER=6037991234567890

LETSENCRYPT_EMAIL=example@email.com
